(function () {
  'use strict';

  // ---------- limpieza de estado previo ----------
  ['__waTimer', '__waAuto'].forEach(k => { if (window[k]) clearInterval(window[k]); });
  if (window.__waObs) window.__waObs.disconnect();
  if (window.__waPanel) window.__waPanel.remove();

  window.__msgs = new Map(); // id -> {id, ts, fecha, autor, texto}
  window.__lastMeta = null;  // {ts, fecha} del último bloque con data-pre-plain-text visto

  // regex tolerante: separa por el ÚLTIMO ']' antes de los ':' finales, no exige coma
  const RX = /^\[(.+)\]\s*(.*?):\s*$/;

  // ---------- helpers de DOM ----------
  function main() { return document.querySelector('#main'); }

  function titulo() {
    const m = main(); if (!m) return '';
    const h = m.querySelector('header');
    return h ? (h.innerText || '').split('\n')[0].trim() : '';
  }
  window.__lock = titulo();

  // parser explícito de "hh:mm a.m./p.m., D/M/YYYY" (formato WhatsApp es-MX).
  // NUNCA usar new Date(texto) a secas: "15/9/2026" es ambiguo para JS (asume MM/DD/YYYY
  // en inglés y falla con día>12), y separar hora/fecha por coma para parsear cada una
  // por separado descarta la hora silenciosamente. Aquí se arma el timestamp a mano.
  function parseTs(raw) {
    const m = raw.match(/(\d{1,2}):(\d{2})\s*([ap])\.?\s*m\.?[.,]?\s*(\d{1,2})\/(\d{1,2})\/(\d{4})/i);
    if (m) {
      let [, hh, mm, ap, dd, mo, yyyy] = m;
      hh = parseInt(hh, 10); mm = parseInt(mm, 10);
      if (ap.toLowerCase() === 'p' && hh !== 12) hh += 12;
      if (ap.toLowerCase() === 'a' && hh === 12) hh = 0;
      const d = new Date(+yyyy, +mo - 1, +dd, hh, mm, 0);
      return isNaN(d.getTime()) ? null : d.getTime();
    }
    // orden invertido "D/M/YYYY, hh:mm a.m." o solo fecha sin hora
    const m2 = raw.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    if (m2) {
      const [, dd, mo, yyyy] = m2;
      let hh = 0, mm = 0;
      const h = raw.match(/(\d{1,2}):(\d{2})\s*([ap])\.?\s*m\.?/i);
      if (h) {
        hh = parseInt(h[1], 10); mm = parseInt(h[2], 10);
        if (h[3].toLowerCase() === 'p' && hh !== 12) hh += 12;
        if (h[3].toLowerCase() === 'a' && hh === 12) hh = 0;
      }
      const d = new Date(+yyyy, +mo - 1, +dd, hh, mm, 0);
      return isNaN(d.getTime()) ? null : d.getTime();
    }
    return null;
  }

  function idDe(row) {
    const el = row.closest('[data-id]') || row.querySelector('[data-id]');
    return el ? el.getAttribute('data-id') : null;
  }

  function meta(row) {
    const el = row.matches('[data-pre-plain-text]') ? row : row.querySelector('[data-pre-plain-text]');
    if (!el) return null;
    const raw = (el.getAttribute('data-pre-plain-text') || '').trim();
    const m = raw.match(RX);
    if (!m) return { fechaTxt: raw, ts: null, autor: '' };
    const fechaTxt = m[1].trim();
    const autor = m[2].trim();
    return { fechaTxt, ts: parseTs(fechaTxt), autor };
  }

  // texto real del mensaje, evitando ruido de checks/hora/reacciones sueltas
  function textoDe(row) {
    const nodos = row.querySelectorAll('span.selectable-text, div.copyable-text span[dir]');
    if (nodos.length) return [...nodos].map(n => n.innerText).join(' ').trim();
    return (row.innerText || '').trim();
  }

  // ---------- captura ----------
  function capturar() {
    try {
      const m = main();
      if (!m) { st('abre el grupo primero'); return; }

      const t = titulo();
      if (window.__lock && t && t !== window.__lock) {
        detener('⛔ cambió el chat — DETENIDO', 'abriste otro chat. Vuelve al grupo "' + window.__lock + '".');
        return;
      }

      const rows = m.querySelectorAll('div[role="row"]');
      if (!rows.length) return;

      rows.forEach(row => {
        try {
          const id = idDe(row);
          if (id && window.__msgs.has(id)) return; // ya capturado, por id real

          const mt = meta(row);
          if (mt && mt.ts) window.__lastMeta = { ts: mt.ts, fecha: mt.fechaTxt };

          const texto = textoDe(row);
          if (!texto) return;

          const ts = (mt && mt.ts) || (window.__lastMeta && window.__lastMeta.ts) || null;
          const fecha = (mt && mt.fechaTxt) || (window.__lastMeta && window.__lastMeta.fecha) || '??';

          // clave: id real si existe; si no, hash simple de texto+fecha como fallback
          const key = id || ('h_' + fecha + '_' + texto.slice(0, 40));
          if (window.__msgs.has(key)) return;

          window.__msgs.set(key, { ts, fecha, texto });
        } catch (e) { /* fila individual rota, seguimos */ }
      });

      const c = document.getElementById('__waCount');
      if (c) c.textContent = 'Capturados: ' + window.__msgs.size;
      const sinFecha = [...window.__msgs.values()].filter(x => !x.ts).length;
      const d = document.getElementById('__waCF');
      if (d) d.textContent = 'Con fecha: ' + (window.__msgs.size - sinFecha) + '  ·  Sin: ' + sinFecha;
    } catch (e) { /* no tumbar el observer por un error puntual */ }
  }

  // ---------- scroll / carga ----------
  function wheel(dir) {
    const m = main(); if (!m) return;
    const el = m.querySelector('div[role="row"]'); if (!el) return;
    (el.parentElement || el).dispatchEvent(new WheelEvent('wheel', { deltaY: dir * 320, bubbles: true, cancelable: true }));
  }

  // busca el botón "cargar más" SOLO por texto conocido, fuera de las filas de mensajes.
  // (importante: NO hay fallback por posición — eso terminaba clickeando el nombre del
  // grupo/header, que también es un div[role="button"] cerca del top, y abría la info del chat)
  function banner() {
    const m = main(); if (!m) return false;
    const candidatos = [...m.querySelectorAll('div[role="button"], button')]
      .filter(x => !x.closest('div[role="row"]') && !x.closest('header'));
    const objetivo = candidatos.find(x =>
      /mensajes anteriores|obtener mensajes|older messages|click here to get|cargar más|load earlier/i.test((x.textContent || '').slice(0, 120))
    );
    if (objetivo) { objetivo.click(); return true; }
    return false;
  }

  function cargando() {
    const m = main();
    return m ? !!m.querySelector('[role="progressbar"]') : false;
  }

  // ---------- panel ----------
  const p = document.createElement('div');
  p.id = '__waPanel';
  window.__waPanel = p;
  p.style.cssText = 'position:fixed;top:80px;right:24px;z-index:2147483647;background:#111;color:#0f0;padding:16px;border-radius:12px;font-family:monospace;font-size:15px;box-shadow:0 6px 24px rgba(0,0,0,.6);text-align:center;min-width:250px;';
  p.innerHTML =
    '<div id="__waLock" style="font-size:11px;color:#6cf;margin-bottom:4px;">🔒 ' + (window.__lock || '(sin chat)') + '</div>' +
    '<div id="__waCount" style="font-size:22px;">Capturados: 0</div>' +
    '<div id="__waCF" style="font-size:13px;color:#ff0;margin-bottom:6px;">Con fecha: 0  ·  Sin: 0</div>' +
    '<div id="__waStatus" style="font-size:12px;color:#7f7;margin-bottom:4px;min-height:16px;">listo</div>' +
    '<div id="__waInfo" style="font-size:11px;color:#999;margin-bottom:12px;min-height:24px;line-height:1.3;"></div>' +
    '<button id="__waAutoBtn" style="background:#06c;color:#fff;border:none;padding:10px 14px;border-radius:8px;font-size:14px;cursor:pointer;margin-bottom:8px;width:100%;">▶ Auto-scroll</button>' +
    '<button id="__waBtn" style="background:#0a7;color:#fff;border:none;padding:10px 14px;border-radius:8px;font-size:14px;cursor:pointer;width:100%;">⬇ Descargar .txt</button>';
  document.body.appendChild(p);

  const st = t => { const s = document.getElementById('__waStatus'); if (s) s.textContent = t; };
  const info = t => { const s = document.getElementById('__waInfo'); if (s) s.textContent = t; };

  // ---------- observer en vez de polling ----------
  const contenedor = main();
  if (contenedor) {
    window.__waObs = new MutationObserver(() => capturar());
    window.__waObs.observe(contenedor, { childList: true, subtree: true });
  }
  // primer barrido inmediato + respaldo por si el observer no dispara en el primer render
  capturar();
  window.__waTimer = setInterval(capturar, 1200);

  // ---------- máquina de estados del auto-scroll ----------
  let running = false, mode = 'normal', stall = 0, pre = 0, wait = 0;
  const MS = 6, MW_BASE = 8;
  let waitLimit = MW_BASE;

  function detener(msg, extra) {
    clearInterval(window.__waAuto);
    running = false; mode = 'normal';
    const b = document.getElementById('__waAutoBtn'); if (b) b.textContent = '▶ Auto-scroll';
    st(msg); if (extra) info(extra);
  }

  function paso() {
    try {
      const m = main(); if (!m) { st('abre el grupo'); return; }
      const rows = m.querySelectorAll('div[role="row"]');
      if (!rows.length) { st('no veo mensajes'); return; }
      const antes = window.__msgs.size;

      if (mode === 'normal') {
        rows[0].scrollIntoView({ block: 'start' });
        capturar();
        if (window.__msgs.size > antes) { stall = 0; waitLimit = MW_BASE; st('subiendo... (' + window.__msgs.size + ')'); info(''); return; }
        pre = window.__msgs.size; mode = 'down'; st('destrabando...'); return;
      }
      if (mode === 'down') {
        rows[Math.min(rows.length - 1, 6)].scrollIntoView({ block: 'center' });
        wheel(1); banner(); mode = 'up'; return;
      }
      if (mode === 'up') {
        rows[0].scrollIntoView({ block: 'start' });
        wheel(-1); capturar();
        if (cargando()) { mode = 'wait'; wait = 0; st('esperando al teléfono...'); return; }
        if (window.__msgs.size > pre) { stall = 0; mode = 'normal'; st('subiendo... (' + window.__msgs.size + ')'); return; }
        stall++; mode = 'normal'; st('reintentando (' + stall + '/' + MS + ')');
        if (stall >= MS) detener('✅ tope real (' + window.__msgs.size + ')', 'todo lo cargable');
        return;
      }
      if (mode === 'wait') {
        capturar();
        if (window.__msgs.size > pre) { stall = 0; mode = 'normal'; st('subiendo... (' + window.__msgs.size + ')'); return; }
        wait++;
        // backoff: si sigue "cargando" de verdad, damos más tiempo antes de tirar la toalla
        const limite = cargando() ? waitLimit + 4 : waitLimit;
        if (wait >= limite) {
          stall++; mode = 'normal'; waitLimit = MW_BASE;
          if (stall >= MS) detener('✅ tope real (' + window.__msgs.size + ')', 'el teléfono ya no manda más');
        }
        return;
      }
    } catch (e) { st('tropecé, sigo'); mode = 'normal'; }
  }

  document.getElementById('__waAutoBtn').onclick = function () {
    if (!window.__lock) { window.__lock = titulo(); const l = document.getElementById('__waLock'); if (l) l.textContent = '🔒 ' + window.__lock; }
    running = !running;
    if (running) {
      mode = 'normal'; stall = 0;
      window.__waAuto = setInterval(paso, 1500);
      this.textContent = '⏸ Pausar'; st('subiendo...');
    } else {
      clearInterval(window.__waAuto);
      this.textContent = '▶ Auto-scroll'; st('pausado');
    }
  };

  document.getElementById('__waBtn').onclick = function () {
    if (!window.__msgs.size) { st('nada que exportar todavía'); return; }
    const ordenados = [...window.__msgs.values()].sort((a, b) => (a.ts || 0) - (b.ts || 0));
    const lineas = ordenados.map(x => '[' + (x.ts ? new Date(x.ts).toLocaleString() : x.fecha) + '] ' + x.texto.replace(/\n+/g, ' · '));
    const blob = new Blob([lineas.join('\n')], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'chat_' + window.__msgs.size + '.txt'; a.click();
    setTimeout(() => URL.revokeObjectURL(url), 4000);
    st('descargado');
  };

  st('listo — ' + (window.__lock ? 'candado en "' + window.__lock + '"' : 'abre el grupo y dale Auto-scroll'));
})();
